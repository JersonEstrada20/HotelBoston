---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../PageHero.astro";
import BookingForm from "../BookingForm.astro";
import Icon from "../Icon.astro";
import { ui, route } from "../../i18n/ui";
import type { Lang } from "../../data/site";
import { images } from "../../data/site";
import { getSiteContent } from "../../lib/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const meta = t.meta.bookings;
const { site } = await getSiteContent();

const title = lang === "es" ? "Solicita tu <em>estadía</em>." : "Request your <em>stay</em>.";
---

<BaseLayout
  lang={lang}
  title={meta.title}
  description={meta.description}
  routeKey="bookings"
  image={images.heroLobby}
>
  <PageHero
    lang={lang}
    eyebrow={t.bookings.eyebrow}
    title={title}
    copy={t.bookings.copy}
    image={images.heroLobby}
    imageAlt={lang === "es" ? "Espacio común del Hotel Boston" : "Common area at Hotel Boston"}
    crumbs={t.nav.book}
  />

  <section class="page-section">
    <div class="booking-layout">
      <aside class="booking-aside">
        <p class="eyebrow">{t.bookings.eyebrow}</p>
        <h2>{t.bookings.formTitle}</h2>
        <p>{t.bookings.formCopy}</p>

        <div class="notice">
          <strong>{t.bookings.noticeTitle}</strong>
          <p>{t.bookings.notice}</p>
        </div>

        <ul class="booking-contact-list">
          <li>
            <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={18} />
              {t.common.whatsapp} · {site.whatsappDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <Icon name="mail" size={18} />
              {site.email}
            </a>
          </li>
          {site.phones.map((phone) => (
            <li>
              <a href={`tel:${phone.href}`}>
                <Icon name="phone" size={18} />
                {phone.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="booking-policies">
          <h2>{t.bookings.policiesTitle}</h2>
          <ul>
            {t.bookings.policies.map((policy) => <li>{policy}</li>)}
          </ul>
          <a class="text-link" href={route(lang, "terms")}>
            {t.bookings.policiesLink}
            <Icon name="arrow" size={16} />
          </a>
        </div>

        <div class="booking-policies">
          <h2>{t.bookings.eventTitle}</h2>
          <p>{t.bookings.eventCopy}</p>
          <a class="text-link" href={route(lang, "salons")}>
            {t.bookings.eventCta}
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </aside>

      <BookingForm lang={lang} />
    </div>
  </section>
</BaseLayout>
