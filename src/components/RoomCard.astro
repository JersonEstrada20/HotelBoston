---
import Icon from "./Icon.astro";
import DynamicImage from "./DynamicImage.astro";
import { ui, formatClp, route } from "../i18n/ui";
import type { Lang } from "../data/site";
import type { PublicRoom } from "../lib/content";

interface Props {
  lang: Lang;
  room: PublicRoom;
  index: number;
}

const { lang, room, index } = Astro.props;
const t = ui[lang];
const bookingHref = `${route(lang, "bookings")}?habitacion=${room.slug}#solicitud`;
const roomName = room.name[lang];
---

<article class="room-card">
  <a class="room-media" href={bookingHref} aria-label={`${t.rooms.cta}: ${roomName}`}>
    <DynamicImage
      src={room.image}
      alt={`${roomName} — Hotel Boston`}
      widths={[420, 720, 1000]}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
      loading="lazy"
    />
    <span class="room-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  </a>
  <div class="room-body">
    <div class="room-title">
      <h3>{roomName}</h3>
      <p>{room.short[lang]}</p>
    </div>
    <ul class="room-meta">
      <li><Icon name="users" size={17} />{room.capacity} {t.common.people}</li>
      <li><Icon name="ruler" size={17} />{room.size}</li>
      <li><Icon name="bed" size={17} />{room.beds[lang]}</li>
    </ul>
    <div class="room-prices">
      {room.prices.map((price) => (
        <div>
          <span>{price.label[lang]}</span>
          <strong>{formatClp(price.amount, lang)}</strong>
        </div>
      ))}
    </div>
    <p class="price-note">{t.common.inclVat}</p>
    <a class="text-link" href={bookingHref}>
      {t.rooms.cta}
      <Icon name="arrow" size={16} />
    </a>
  </div>
</article>
