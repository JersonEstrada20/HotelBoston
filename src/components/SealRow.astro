---
import type { Lang } from "../data/site";
import { images } from "../data/site";
import { ui } from "../i18n/ui";

interface Props {
  lang: Lang;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = ui[lang];
---

<div class:list={["seal-row", { compact }]}>
  <img src={images.seals.sernatur.src} width="237" height="143" alt="Certificación de calidad turística Sernatur" loading="lazy" />
  <img src={images.seals.q.src} width="50" height="185" alt="Sello Q de Calidad Turística" loading="lazy" />
  <img src={images.seals.esnna.src} width="250" height="300" alt="Certificación ESNNA" loading="lazy" />
  <span>{t.home.certification}</span>
</div>
