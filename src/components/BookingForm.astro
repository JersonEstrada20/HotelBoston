---
import Icon from "./Icon.astro";
import { ui, formatClp, route } from "../i18n/ui";
import type { Lang } from "../data/site";
import { getSiteContent } from "../lib/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const { site, rooms: roomTypes, salons } = await getSiteContent();
---

<div class="booking-form-wrap" id="solicitud">
  <form
    class="booking-form"
    data-booking-form
    data-email={site.email}
    data-whatsapp={site.whatsapp}
    data-intro={t.bookings.requestIntro}
    data-msg-dates={t.bookings.validationDates}
    data-msg-email={t.bookings.openingEmail}
    data-msg-whatsapp={t.bookings.openingWhatsapp}
    data-msg-sending={t.bookings.sending}
    data-msg-success={t.bookings.submitSuccess}
    data-msg-error={t.bookings.submitError}
    data-msg-phone={t.bookings.missingPhone}
    data-msg-reference={t.bookings.submitReference}
    data-rooms-group={t.bookings.roomsGroup}
    data-salons-group={t.bookings.salonsGroup}
    data-availability-checking={t.bookings.checkingAvailability}
    data-availability-label={t.bookings.checkAvailability}
    data-availability-available={t.bookings.availableMessage}
    data-availability-capacity={t.bookings.capacityMessage}
    data-availability-occupied={t.bookings.occupiedMessage}
    data-availability-unavailable={t.bookings.unavailableMessage}
    data-availability-error={t.bookings.availabilityError}
    novalidate
  >
    <div class="form-grid">
      <label class="field" for="booking-name">
        <span>{t.bookings.name}</span>
        <input type="text" name="name" id="booking-name" autocomplete="name" required />
      </label>

      <label class="field" for="booking-email">
        <span>{t.bookings.email}</span>
        <input type="email" name="email" id="booking-email" autocomplete="email" required />
      </label>

      <label class="field" for="booking-phone">
        <span>{t.bookings.phone}</span>
        <input type="tel" name="phone" id="booking-phone" autocomplete="tel" required />
      </label>

      <label class="field" for="booking-room">
        <span>{t.bookings.room}</span>
        <select name="room" id="booking-room" required>
          <option value="">{t.bookings.roomPlaceholder}</option>
          <optgroup label={t.bookings.roomsGroup}>
            {roomTypes.map((room) => (
              <option value={`room:${room.slug}`} data-cabin-name={room.name[lang]} data-space-type="habitacion">
                {room.name[lang]}{room.prices[0] ? ` — ${formatClp(room.prices[0].amount, lang)}` : ""}
              </option>
            ))}
          </optgroup>
          <optgroup label={t.bookings.salonsGroup}>
            {salons.map((salon) => (
              <option value={`salon:${salon.slug}`} data-cabin-name={salon.name} data-space-type="salon">
                Salón {salon.name} — {salon.capacity} {t.common.people}
              </option>
            ))}
          </optgroup>
        </select>
      </label>

      <label class="field" for="booking-arrival">
        <span>{t.bookings.arrival}</span>
        <input type="date" name="arrival" id="booking-arrival" required />
      </label>

      <label class="field" for="booking-departure">
        <span>{t.bookings.departure}</span>
        <input type="date" name="departure" id="booking-departure" required />
      </label>

      <label class="field" for="booking-guests">
        <span>{t.bookings.guests}</span>
        <input type="number" name="guests" id="booking-guests" min="1" max="100" value="2" required />
      </label>

      <label class="field field-full" for="booking-message">
        <span>{t.bookings.message}</span>
        <textarea name="message" id="booking-message" rows="4"></textarea>
      </label>
    </div>

    <div class="availability-check">
      <button class="button button-outline" type="button" data-availability-button>
        <Icon name="calendar" size={18} />
        <span data-availability-label>{t.bookings.checkAvailability}</span>
      </button>
      <p class="availability-status" data-availability-status role="status" aria-live="polite" hidden></p>
    </div>

    <label class="checkbox-field" for="booking-consent">
      <input type="checkbox" name="consent" id="booking-consent" required />
      <span>
        {t.bookings.consent}
        <a href={route(lang, "privacy")} target="_blank" rel="noopener noreferrer">{t.privacy.title}</a>.
      </span>
    </label>

    <div class="form-status" data-form-status role="status" aria-live="polite"></div>

    <div class="form-actions">
      <button class="button" type="submit" data-submit-button>
        <Icon name="mail" size={18} />
        <span data-submit-label>{t.bookings.submitEmail}</span>
      </button>
      <button class="button button-outline" type="button" data-whatsapp-submit>
        <Icon name="whatsapp" size={18} />
        {t.bookings.submitWhatsapp}
      </button>
    </div>
    <p class="form-note">{t.bookings.formNote}</p>
  </form>
</div>

<script>
  import { initBookingForm } from "../scripts/booking-form";

  initBookingForm();
</script>
