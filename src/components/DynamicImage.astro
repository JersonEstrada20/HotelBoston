---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: "eager" | "lazy";
}

const { src, alt, widths, sizes, class: className, loading = "lazy" } = Astro.props;
---

{
  typeof src === "string" ? (
    <img src={src} alt={alt} class={className} loading={loading} />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      class={className}
      loading={loading}
    />
  )
}
