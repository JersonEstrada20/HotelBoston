---
interface Props {
  eyebrow?: string;
  title: string;
  copy?: string;
  align?: "left" | "center";
  light?: boolean;
}

const { eyebrow, title, copy, align = "left", light = false } = Astro.props;
---

<div class:list={["section-heading", `align-${align}`, { light }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 set:html={title} />
  {copy && <p class="section-copy">{copy}</p>}
  <slot />
</div>
