---
import Icon from "./Icon.astro";
import DynamicImage from "./DynamicImage.astro";
import { ui, route } from "../i18n/ui";
import type { Lang } from "../data/site";
import type { PublicSalon } from "../lib/content";

interface Props {
  lang: Lang;
  salon: PublicSalon;
}

const { lang, salon } = Astro.props;
const t = ui[lang];
const bookingHref = `${route(lang, "bookings")}?salon=${salon.slug}#solicitud`;
---

<article class="salon-card">
  <a class="salon-media" href={bookingHref} aria-label={`${t.salons.cta}: ${salon.name}`}>
    <DynamicImage
      src={salon.image}
      alt={`Salón ${salon.name} — Hotel Boston`}
      widths={[420, 720, 1200]}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
      loading="lazy"
    />
  </a>
  <div class="salon-body">
    <div class="salon-head">
      <h3>Salón {salon.name}</h3>
      <span class="salon-capacity">
        <Icon name="users" size={16} />
        {salon.capacity} {t.common.people}
      </span>
    </div>
    <p>{salon.description[lang]}</p>
    <a class="text-link" href={bookingHref}>
      {t.salons.cta}
      <Icon name="arrow" size={16} />
    </a>
  </div>
</article>
